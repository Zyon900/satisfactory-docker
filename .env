# =============================================================================
# Satisfactory Dedicated Server Configuration
# =============================================================================

# --- Network & Ports ---------------------------------------------------------
# Primary game & HTTPS API port (UDP + TCP). Host and container port must match.
GAME_PORT=7777

# Reliable messaging port introduced in Satisfactory 1.1 (TCP).
RELIABLE_PORT=8888

# Optional external reliable port if behind NAT port-remapping (leave empty to disable).
EXTERNAL_RELIABLE_PORT=

# IP address for the server to bind to inside the container.
MULTIHOME=0.0.0.0

# Optional max player cap override (leave empty to use Game.ini / default).
MAX_PLAYERS=

# --- Updates & SteamCMD ------------------------------------------------------
# Check Steam on every container start/restart and pull updates if available.
AUTO_UPDATE=true

# Run SteamCMD 'validate' on every update check (slower startup; always runs on first install).
VALIDATE_INSTALL=false

# Steam branch: 'public' (default) or 'experimental'.
STEAM_BETA=public
STEAM_BETA_PASSWORD=

# --- Mods (SMM Profile) ------------------------------------------------------
# Path to the .smmprofile file (relative to docker-compose.yaml or absolute path).
MODS_PROFILE_FILE=./mods.smmprofile

# Set to false to temporarily disable all mods and run vanilla without deleting mods.smmprofile.
MODS_ENABLED=true

# --- Container Runtime -------------------------------------------------------
# Host user/group IDs for file ownership on ./saves and ./data volumes.
PUID=1000
PGID=1000

# Additional command-line arguments passed directly to FactoryServer.sh.
EXTRA_SERVER_ARGS=
